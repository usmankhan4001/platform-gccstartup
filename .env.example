# Database
POSTGRES_DB=gccplatform
POSTGRES_USER=gccplatform
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://gccplatform:change-me@postgres:5432/gccplatform

# Auth
JWT_SECRET=change-me-to-a-random-string-min-32-chars
SESSION_COOKIE_NAME=gcc_session
SESSION_MAX_AGE=604800

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Amazon SES
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM_EMAIL=noreply@gccstartup.com
SES_FROM_NAME=GCC Startup

# Meta WhatsApp Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WEBHOOK_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_GRAPH_VERSION=v20.0

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PostHog
POSTHOG_KEY=
POSTHOG_HOST=

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# First-run seed (only used by `pnpm db:seed`)
SEED_ADMIN_EMAIL=admin@gccstartup.com
SEED_ADMIN_PASSWORD=change-me-after-first-login
